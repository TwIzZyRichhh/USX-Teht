### Add media item (expect 201)
POST http://localhost:3000/api/media
Content-Type: application/json

{
  "filename": "60ac.jpg",
  "title": "New image",
  "description": "The description of the new image",
  "user_id": 305,
  "media_type": "image/jpeg"
}

### Add media item with missing fields (expect 400)
POST http://localhost:3000/api/media
Content-Type: application/json

{
  "title": "No filename"
}

### Modify media item (expect 200)
PUT http://localhost:3000/api/media/9590
Content-Type: application/json

{
  "title": "Basement modified",
  "description": "Some new description"
}

### Delete media item (expect 200)
DELETE http://localhost:3000/api/media/9590

### Delete again (expect 404)
DELETE http://localhost:3000/api/media/9590

### Add user (expect 201)
POST http://localhost:3000/api/user
Content-Type: application/json

{
  "username": "TestUser",
  "password": "secret",
  "email": "test@example.com"
}